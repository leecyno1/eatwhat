# 《吃什么》应用环境配置文件 - 示例模板
# 复制此文件为 .env 并填入真实的配置值

# ========================================
# AI服务配置（MiniMax）
# ========================================
# 生产模式：客户端只配置 EXECUTION_PROXY_BASE_URL（见下方执行层代理段），
# 不打包任何 AI 密钥——AI 文本调用经执行代理的
# POST /api/v1/ai/chat/completions 转发，MiniMax 密钥只留在服务端。
# 本地直连：配置下方「MiniMax 直连配置」段的密钥即可（有本地密钥时优先直连）。
AI_IMAGE_MODEL_NAME=image-01
ENABLE_LIVE_DISH_IMAGE_GENERATION=false
V2_DEBUG_BOOTSTRAP=home

# ========================================
# MiniMax 直连配置（仅本地开发联调，禁止打进生产构建）
# ========================================
MINIMAX_API_KEY=
MINIMAX_CHAT_API_URL=https://api.minimaxi.com/v1
MINIMAX_CHAT_MODEL=MiniMax-M2.7
MINIMAX_API_URL=https://api.minimaxi.com/v1/image_generation
MINIMAX_IMAGE_MODEL=image-01
PREBUILT_IMAGE_INDEX_URL=
PREBUILT_IMAGE_BASE_URL=

# ========================================
# AI模型配置
# ========================================
# 主要模型：用于食物推荐和分析
AI_MODEL_NAME=MiniMax-M2.7
# 备用模型：当主模型不可用时使用
AI_FALLBACK_MODEL=MiniMax-M2.7

# ========================================
# AI服务参数
# ========================================
# 请求超时时间（秒）
AI_REQUEST_TIMEOUT=60
# 最大重试次数
AI_MAX_RETRIES=3
# 温度（MiniMax 官方范围 0.0-1.0）
AI_TEMPERATURE=1.0
# Top-P
AI_TOP_P=0.95
# 最大输出 token
AI_MAX_TOKENS=4096
# 推荐缓存时间（小时）
AI_CACHE_DURATION=24

# ========================================
# 安全配置
# ========================================
# 密码哈希盐值（请生成随机字符串）
PASSWORD_SALT=your_random_salt_here
# JWT密钥（请生成随机字符串）
JWT_SECRET=your_jwt_secret_here
# 加密密钥（请生成随机字符串）
ENCRYPTION_KEY=your_encryption_key_here

# ========================================
# 调试配置
# ========================================
# 是否启用调试模式
DEBUG_MODE=false

# ========================================
# 功能开关
# ========================================
# 是否启用AI推荐功能
ENABLE_AI_RECOMMENDATIONS=true

# ========================================
# 平台开放 API（到店/外卖）配置（需要申请资质）
# ========================================
# 注意：以下平台密钥只允许配置在代理后端，不要打进 Flutter 安装包。
# Flutter 客户端正式链路只使用下面的 EXECUTION_PROXY_* 配置。

# 美团开放平台（示例字段名；以你实际开通的产品线为准）
MEITUAN_OPEN_BASE_URL=
MEITUAN_APP_KEY=
MEITUAN_APP_SECRET=
MEITUAN_ACCESS_TOKEN=

# 饿了么开放平台（示例字段名；以你实际开通的产品线为准）
ELEME_OPEN_BASE_URL=
ELEME_APP_KEY=
ELEME_APP_SECRET=
ELEME_ACCESS_TOKEN=

# 大众点评（通常与美团体系相关；如有独立开放能力，请在此配置）
DIANPING_OPEN_BASE_URL=
DIANPING_APP_KEY=
DIANPING_APP_SECRET=
DIANPING_ACCESS_TOKEN=

# 京东外卖/秒送请从京东商家开放平台申请企业应用与对应权限。
# 其密钥同样只配置在代理后端。

# ========================================
# 执行层代理服务（推荐正式方案）
# ========================================
# 客户端只请求自己的代理后端，由代理后端调用四个平台的官方开放能力。
EXECUTION_PROXY_BASE_URL=
EXECUTION_PROXY_AUTH_TOKEN=
# 正式点单必须配置注册/登录服务；留空只用于离线 UI 开发，不能调用真实美团订单链路。
# 认证服务必须与执行网关共享同一个 JWT 密钥。
EATWHAT_AUTH_BASE_URL=
EXECUTION_PROXY_HEALTH_PATH=/health
MEITUAN_DELIVERY_MATCH_PATH=/v2/execution/meituan/delivery-match
MEITUAN_MERCHANT_SEARCH_PATH=/api/v1/delivery/merchants/search
MEITUAN_PRODUCT_SEARCH_PATH=/api/v1/delivery/products/search
MEITUAN_ORDER_PREVIEW_PATH=/api/v1/delivery/order-previews
MEITUAN_ORDER_SUBMIT_PATH=/api/v1/delivery/orders
MEITUAN_OAUTH_STATUS_PATH=/api/v1/delivery/oauth/status
MEITUAN_OAUTH_AUTHORIZE_PATH=/api/v1/delivery/oauth/authorize
MEITUAN_PAYMENT_SUCCESS_URL=
MEITUAN_PAYMENT_FAILURE_URL=
ELEME_DELIVERY_MATCH_PATH=/v2/execution/eleme/delivery-match
DIANPING_DELIVERY_MATCH_PATH=/v2/execution/dianping/delivery-match
DIANPING_DINE_IN_MATCH_PATH=/v2/execution/dianping/dine-in-match
JD_DELIVERY_MATCH_PATH=/v2/execution/jd-delivery/delivery-match

# ========================================
# 执行代理服务端（仅部署环境配置，禁止打包进 Flutter）
# ========================================
EXECUTION_PROXY_BIND_ADDRESS=127.0.0.1
EXECUTION_PROXY_PORT=8787
EXECUTION_PROXY_REQUIRED_TOKEN=
# 与“吃什么”登录系统签发 JWT 使用同一服务端密钥，网关据此取得用户 ID。
EXECUTION_PROXY_JWT_SECRET=
EXECUTION_PROXY_LOCAL_USER_ID=local-eatwhat-user
EXECUTION_PROXY_ALLOWED_ORIGIN=
EXECUTION_PROXY_UPSTREAM_TIMEOUT_MS=6000

# AI 聊天代理（密钥只留服务端；客户端无 MINIMAX_API_KEY 时自动走该路由）
MINIMAX_API_KEY=
MINIMAX_CHAT_API_URL=https://api.minimaxi.com/v1
# AI 聊天补全上游超时（毫秒，默认 90000；配送接口用上面的 6 秒超时）
EXECUTION_PROXY_AI_UPSTREAM_TIMEOUT_MS=90000

# 每个平台适配器负责官方签名、授权和字段标准化。
MEITUAN_EXECUTION_ADAPTER_URL=
MEITUAN_EXECUTION_ADAPTER_TOKEN=

# 美团消费者点餐适配器（服务端专用，不是联盟推广接口）
MEITUAN_MERCHANT_SEARCH_ADAPTER_URL=
MEITUAN_PRODUCT_SEARCH_ADAPTER_URL=
MEITUAN_ORDER_PREVIEW_ADAPTER_URL=
MEITUAN_ORDER_SUBMIT_ADAPTER_URL=
MEITUAN_OAUTH_STATUS_ADAPTER_URL=
MEITUAN_OAUTH_AUTHORIZE_ADAPTER_URL=
MEITUAN_DELIVERY_ADAPTER_BIND_ADDRESS=127.0.0.1
MEITUAN_DELIVERY_ADAPTER_PORT=8788
MEITUAN_DELIVERY_ADAPTER_REQUIRED_TOKEN=
MEITUAN_OPEN_APP_ID=
MEITUAN_OPEN_APP_SECRET=
# 仅用于本地联调。生产环境应按当前登录用户从服务端 OAuth 凭证库读取。
MEITUAN_OPEN_ACCESS_TOKEN=
MEITUAN_OPEN_ID=
# 只有美团审核开通订单预览/提交权限后才能设为 true。
MEITUAN_OPEN_ORDER_ENABLED=false
MEITUAN_OPEN_REVIEW_MODE=true
MEITUAN_ALLOW_LOCAL_USER_FALLBACK=false
MEITUAN_LOCAL_USER_ID=local-eatwhat-user
MEITUAN_OPEN_API_BASE_URL=https://openapi.waimai.meituan.com
MEITUAN_OPEN_UPSTREAM_TIMEOUT_MS=6000
MEITUAN_OAUTH_REDIRECT_URL=
MEITUAN_OAUTH_STORE_PATH=.dart_tool/eatwhat/meituan_oauth.json

# 吃什么账号后端（服务端专用）
EATWHAT_AUTH_BIND_ADDRESS=127.0.0.1
EATWHAT_AUTH_PORT=8790
EATWHAT_AUTH_JWT_SECRET=
EATWHAT_AUTH_STORE_PATH=.dart_tool/eatwhat/users.json
EATWHAT_AUTH_TOKEN_TTL_HOURS=24

ELEME_EXECUTION_ADAPTER_URL=
ELEME_EXECUTION_ADAPTER_TOKEN=
JD_DELIVERY_EXECUTION_ADAPTER_URL=
JD_DELIVERY_EXECUTION_ADAPTER_TOKEN=
DIANPING_EXECUTION_ADAPTER_URL=
DIANPING_EXECUTION_ADAPTER_TOKEN=
DIANPING_DINE_IN_ADAPTER_URL=
DIANPING_DINE_IN_ADAPTER_TOKEN=

# ==================== 会员凭证（服务端签发验签） ====================
# 本地联调：种子与 mock 代理共用，双端派生同一 Ed25519 密钥对
# MEMBERSHIP_SIGNING_SEED=eatwhat-dev-seed
# 生产：客户端只内嵌验签公钥（私钥只留在服务端）
# MEMBERSHIP_SIGNING_PUBLIC_KEY=

# ==================== 支付服务端（scripts/payment_server.dart，禁止打包进 Flutter） ====================
# 启动：dart run scripts/payment_server.dart [port]
# 客户端轮询 /api/v1/payment/alipay/status 走 EXECUTION_PROXY_BASE_URL，
# 生产环境需在网关（如 nginx）把以下 payment 路径转发到本服务：
#   POST /api/v1/payment/alipay/orders
#   GET  /api/v1/payment/alipay/status
#   POST /api/v1/payment/alipay/notify（支付宝服务器回调，需公网可达）
# JWT_SECRET 复用「安全配置」段：与登录服务签发 access token 的密钥一致；
# 留空 = 本地开发模式（body userId / x-eatwhat-user-id 直接生效）。

# 支付宝开放平台应用
ALIPAY_APP_ID=
ALIPAY_GATEWAY_URL=https://openapi.alipay.com/gateway.do
# 商户应用私钥 PEM（PKCS#8 或 PKCS#1）整体做一次 base64；flutter_dotenv 不支持多行值
ALIPAY_MERCHANT_PRIVATE_KEY_PEM_B64=
# 支付宝平台公钥 PEM（用于验签异步通知与响应）整体做一次 base64
ALIPAY_PUBLIC_KEY_PEM_B64=
# 异步通知回调的公网地址（即上面 notify 路由的完整 URL）
PAYMENT_NOTIFY_URL=

# 会员套餐：三键齐全才生效，价格必须显式配置（ID 限大写字母/数字）
PAYMENT_PLAN_YEARLY_SUBJECT=吃什么年度会员
PAYMENT_PLAN_YEARLY_TOTAL_AMOUNT=12.00
PAYMENT_PLAN_YEARLY_DAYS=365

PAYMENT_SERVER_BIND_ADDRESS=127.0.0.1
PAYMENT_SERVER_PORT=8791
PAYMENT_SERVER_LOCAL_USER_ID=local-eatwhat-user
PAYMENT_ORDER_STORE_PATH=.dart_tool/eatwhat/payment_orders.json
PAYMENT_ALLOWED_ORIGIN=
