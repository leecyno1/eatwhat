# 《吃什么》应用环境配置文件 - 示例模板
# 复制此文件为 .env 并填入真实的配置值

# ========================================
# AI服务配置 - SiliconFlow
# ========================================
SILICONFLOW_API_KEY=your_api_key_here
SILICONFLOW_API_URL=https://api.siliconflow.cn/v1

# ========================================
# AI模型配置
# ========================================
# 主要模型：用于食物推荐和分析
AI_MODEL_NAME=Qwen/Qwen3-30B-A3B
# 备用模型：当主模型不可用时使用
AI_FALLBACK_MODEL=gpt-3.5-turbo

# ========================================
# AI服务参数
# ========================================
# 请求超时时间（秒）
AI_REQUEST_TIMEOUT=30
# 最大重试次数
AI_MAX_RETRIES=3
# 推荐缓存时间（小时）
AI_CACHE_DURATION=24

# ========================================
# 推荐引擎配置
# ========================================
# 推荐策略：hybrid（混合）, ai_only（仅AI）, traditional（传统）
RECOMMENDATION_STRATEGY=hybrid
# 每次推荐的最大数量
MAX_RECOMMENDATIONS=10
# AI推荐权重（0.0-1.0）
AI_RECOMMENDATION_WEIGHT=0.7

# ========================================
# 安全配置
# ========================================
# 密码哈希盐值（请生成随机字符串）
PASSWORD_SALT=your_random_salt_here
# JWT密钥（请生成随机字符串）
JWT_SECRET=your_jwt_secret_here
# 加密密钥（请生成随机字符串）
ENCRYPTION_KEY=your_encryption_key_here

# ========================================
# 调试和日志配置
# ========================================
# 是否启用调试模式
DEBUG_MODE=false
# 是否打印AI请求和响应日志（生产环境请设为false）
LOG_AI_REQUESTS=false
# 是否启用性能监控
ENABLE_PERFORMANCE_MONITORING=true

# ========================================
# 功能开关
# ========================================
# 是否启用AI推荐功能
ENABLE_AI_RECOMMENDATIONS=true
# 是否启用推荐解释功能
ENABLE_RECOMMENDATION_EXPLANATIONS=true
# 是否启用用户偏好学习
ENABLE_PREFERENCE_LEARNING=true