# 《吃什么》应用环境配置文件 - 示例模板
# 复制此文件为 .env 并填入真实的配置值

# ========================================
# AI服务配置 - SiliconFlow
# ========================================
SILICONFLOW_API_KEY=your_api_key_here
SILICONFLOW_API_URL=https://api.minimaxi.com/v1
AI_IMAGE_MODEL_NAME=image-01
ENABLE_LIVE_DISH_IMAGE_GENERATION=false
V2_DEBUG_BOOTSTRAP=home

# ========================================
# 预制菜图库与 MiniMax 批处理配置
# ========================================
MINIMAX_API_KEY=
MINIMAX_API_URL=https://api.minimaxi.com/v1/image_generation
MINIMAX_IMAGE_MODEL=image-01
PREBUILT_IMAGE_INDEX_URL=
PREBUILT_IMAGE_BASE_URL=

# ========================================
# AI模型配置
# ========================================
# 主要模型：用于食物推荐和分析
AI_MODEL_NAME=MiniMax-M2.7
# 备用模型：当主模型不可用时使用
AI_FALLBACK_MODEL=MiniMax-M2.7

# ========================================
# AI服务参数
# ========================================
# 请求超时时间（秒）
AI_REQUEST_TIMEOUT=60
# 最大重试次数
AI_MAX_RETRIES=3
# 温度（MiniMax 官方范围 0.0-1.0）
AI_TEMPERATURE=1.0
# Top-P
AI_TOP_P=0.95
# 最大输出 token
AI_MAX_TOKENS=4096
# 推荐缓存时间（小时）
AI_CACHE_DURATION=24

# ========================================
# 推荐引擎配置
# ========================================
# 推荐策略：hybrid（混合）, ai_only（仅AI）, traditional（传统）
RECOMMENDATION_STRATEGY=hybrid
# 每次推荐的最大数量
MAX_RECOMMENDATIONS=10
# AI推荐权重（0.0-1.0）
AI_RECOMMENDATION_WEIGHT=0.7

# ========================================
# 安全配置
# ========================================
# 密码哈希盐值（请生成随机字符串）
PASSWORD_SALT=your_random_salt_here
# JWT密钥（请生成随机字符串）
JWT_SECRET=your_jwt_secret_here
# 加密密钥（请生成随机字符串）
ENCRYPTION_KEY=your_encryption_key_here

# ========================================
# 调试和日志配置
# ========================================
# 是否启用调试模式
DEBUG_MODE=false
# 是否打印AI请求和响应日志（生产环境请设为false）
LOG_AI_REQUESTS=false
# 是否启用性能监控
ENABLE_PERFORMANCE_MONITORING=true

# ========================================
# 功能开关
# ========================================
# 是否启用AI推荐功能
ENABLE_AI_RECOMMENDATIONS=true
# 是否启用推荐解释功能
ENABLE_RECOMMENDATION_EXPLANATIONS=true
# 是否启用用户偏好学习
ENABLE_PREFERENCE_LEARNING=true

# ========================================
# 平台开放 API（到店/外卖）配置（需要申请资质）
# ========================================
# 注意：
# - 这些并非“深链跳转”，而是“直接调用官方开放平台 API”所需的配置。
# - 具体字段/签名/鉴权方式以官方文档为准；本项目会提供 Provider 接口与可替换签名器。

# 美团开放平台（示例字段名；以你实际开通的产品线为准）
MEITUAN_OPEN_BASE_URL=
MEITUAN_APP_KEY=
MEITUAN_APP_SECRET=
MEITUAN_ACCESS_TOKEN=

# 饿了么开放平台（示例字段名；以你实际开通的产品线为准）
ELEME_OPEN_BASE_URL=
ELEME_APP_KEY=
ELEME_APP_SECRET=
ELEME_ACCESS_TOKEN=

# 大众点评（通常与美团体系相关；如有独立开放能力，请在此配置）
DIANPING_OPEN_BASE_URL=
DIANPING_APP_KEY=
DIANPING_APP_SECRET=
DIANPING_ACCESS_TOKEN=

# ========================================
# 执行层代理服务（推荐正式方案）
# ========================================
# 客户端只请求你自己的代理后端，由代理后端调用美团/点评/饿了么开放平台。
EXECUTION_PROXY_BASE_URL=
EXECUTION_PROXY_AUTH_TOKEN=
MEITUAN_DELIVERY_MATCH_PATH=/v2/execution/meituan/delivery-match
