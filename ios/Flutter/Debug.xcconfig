#include? "Pods/Target Support Files/Pods-Runner/Pods-Runner.debug.xcconfig"
#include "Generated.xcconfig"

// 确保 Runner 能正确链接 Flutter 引擎（避免 _FlutterAppDelegate 等符号缺失）
OTHER_LDFLAGS = $(inherited) -framework Flutter
FRAMEWORK_SEARCH_PATHS[sdk=iphonesimulator*] = "$(FLUTTER_ROOT)/bin/cache/artifacts/engine/ios/Flutter.xcframework/ios-arm64_x86_64-simulator" $(inherited)
FRAMEWORK_SEARCH_PATHS[sdk=iphoneos*] = "$(FLUTTER_ROOT)/bin/cache/artifacts/engine/ios/Flutter.xcframework/ios-arm64" $(inherited)
