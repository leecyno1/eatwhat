#include? "Pods/Target Support Files/Pods-Runner/Pods-Runner.release.xcconfig"
#include "Generated.xcconfig"

// Release/Profile 使用 release 引擎产物路径
OTHER_LDFLAGS = $(inherited) -framework Flutter
FRAMEWORK_SEARCH_PATHS[sdk=iphonesimulator*] = "$(FLUTTER_ROOT)/bin/cache/artifacts/engine/ios-release/Flutter.xcframework/ios-arm64_x86_64-simulator" $(inherited)
FRAMEWORK_SEARCH_PATHS[sdk=iphoneos*] = "$(FLUTTER_ROOT)/bin/cache/artifacts/engine/ios-release/Flutter.xcframework/ios-arm64" $(inherited)
